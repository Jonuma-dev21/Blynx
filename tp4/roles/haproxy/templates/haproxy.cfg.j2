global
  log /dev/log local0
  maxconn 4096
  user haproxy
  group haproxy

defaults
  log global
  mode tcp
  option tcplog
  timeout connect 5s
  timeout client 1m
  timeout server 1m

frontend mysql_front
  bind *:{{ haproxy_frontend_port }}
  default_backend mysql_back

backend mysql_back
  balance roundrobin
{% for backend in mysql_backends %}
  server {{ backend.name }} {{ backend.ip }}:{{ backend.port }} check
{% endfor %}
